    "google-auth-library": "^9.15.0",
    "mammoth": "^1.12.2",
    "pdf-parse": "^1.1.1",
    "pdf-to-printer": "^5.8.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pdf-parse": "^1.1.5",
